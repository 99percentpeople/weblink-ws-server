LOG_LEVEL=debug
HOSTNAME=0.0.0.0
PORT=9000
HEARTBEAT_INTERVAL=30000
PONG_TIMEOUT=60000
DISCONNECT_TIMEOUT=90000
REDIS_URL=
NODE_ENV=development

# WebSocket abuse controls; these do not apply to public TURN credentials.
MAX_WS_HANDSHAKES_PER_IP_PER_MINUTE=60
MAX_WS_CONNECTIONS_PER_IP=64
WS_JOIN_TIMEOUT_MS=15000
MAX_ACTIVE_ROOMS=10000
MAX_CLIENTS_PER_ROOM=128
# Set only for trusted proxies that overwrite X-Real-IP.
TRUSTED_PROXY_IPS=

# Cloudflare TURN key values used only by the backend.
TURN_KEY_ID=replace-with-turn-key-id
TURN_KEY_API_TOKEN=replace-with-turn-key-api-token
